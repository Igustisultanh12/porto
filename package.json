{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "build": "vite build && vite build --ssr",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint resources/js tests/browser",
        "format": "prettier --write resources/js resources/css tests/browser playwright.config.ts vite.config.ts eslint.config.js",
        "format:check": "prettier --check resources/js resources/css tests/browser playwright.config.ts vite.config.ts eslint.config.js",
        "test:e2e": "node tests/browser/run.mjs"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.0.0",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@playwright/test": "^1.58.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^22.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.0.0",
        "eslint-plugin-vue": "^10.0.0",
        "globals": "^16.0.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.0.0",
        "vite": "^8.0.0",
        "vue-tsc": "^3.0.0"
    }
}
